# Copy to .env and edit. Real environment variables override these.

# Seconds between lines, so a room can read along. 0 when testing.
LAB_DELAY=0.7

# offline (default): scripted replies, same result every run. Use this on stage.
# openai: any OpenAI-compatible server (OpenAI, Groq, vLLM, Ollama, LM Studio).
# anthropic: Claude with an API key.
# claude: Claude through the Claude Code CLI and your saved login, no API key.
#         LAB_MODEL optional: sonnet (default), haiku, opus. Run `claude` once to log in.
LAB_LLM=offline
LAB_MODEL=
# Seconds before a model call gives up (default 20, or 90 for claude). After one failure the rest of the run
# uses scripted replies, so the demo never hangs.
LAB_TIMEOUT=

# LAB_LLM=openai
OPENAI_API_KEY=
# Leave empty for OpenAI. Examples:
#   Groq (free tier): https://api.groq.com/openai/v1
#   Ollama:           http://localhost:11434/v1
OPENAI_BASE_URL=

# LAB_LLM=anthropic
ANTHROPIC_API_KEY=

# Notebooks: Gemini through Google AI Studio
GEMINI_API_KEY=

# LAB_LLM=claude: only if claude isn't on PATH or bundled with the VS Code extension
CLAUDE_BIN=

# Live sites: 1 hides Chrome while it collects listings (sites block a hidden browser more often)
MARKETPLACE_BROWSER_HEADLESS=0
